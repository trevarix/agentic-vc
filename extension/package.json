{
  "name": "avc",
  "displayName": "AVC — Agentic Version Control",
  "description": "Save, browse, and restore project snapshots without Git.",
  "version": "0.2.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onView:avcSnapshots"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "avc-sidebar",
          "title": "AVC Snapshots",
          "icon": "media/avc-icon.svg"
        }
      ]
    },
    "views": {
      "avc-sidebar": [
        {
          "id": "avcSnapshots",
          "name": "Snapshots",
          "icon": "media/avc-icon.svg",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "avc.saveSnapshot",
        "title": "AVC: Save Snapshot",
        "icon": "$(add)"
      },
      {
        "command": "avc.refreshSnapshots",
        "title": "AVC: Refresh Snapshots",
        "icon": "$(refresh)"
      },
      {
        "command": "avc.restoreSnapshot",
        "title": "AVC: Restore This Snapshot"
      },
      {
        "command": "avc.viewDiff",
        "title": "AVC: View Diff"
      },
      {
        "command": "avc.viewInfo",
        "title": "AVC: View Snapshot Details"
      },
      {
        "command": "avc.deleteSnapshot",
        "title": "AVC: Delete Snapshot"
      },
      {
        "command": "avc.createBranch",
        "title": "AVC: Create Branch",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "avc.switchBranch",
        "title": "AVC: Switch Branch"
      },
      {
        "command": "avc.deleteBranch",
        "title": "AVC: Delete Branch"
      },
      {
        "command": "avc.mergeBranch",
        "title": "AVC: Merge Branch to Main",
        "icon": "$(git-merge)"
      },
      {
        "command": "avc.abortMerge",
        "title": "AVC: Abort Merge"
      },
      {
        "command": "avc.filterSnapshots",
        "title": "AVC: Filter Snapshots",
        "icon": "$(search)"
      },
      {
        "command": "avc.compareTwoSnapshots",
        "title": "AVC: Compare Two Snapshots",
        "icon": "$(diff)"
      },
      {
        "command": "avc.diffWithCurrent",
        "title": "AVC: Diff with Current Files"
      },
      {
        "command": "avc.showTimeline",
        "title": "AVC: Show Timeline",
        "icon": "$(timeline)"
      },
      {
        "command": "avc.restoreFile",
        "title": "AVC: Restore Single File"
      },
      {
        "command": "avc.toggleAnnotations",
        "title": "AVC: Toggle Line Annotations"
      },
      {
        "command": "avc.openWorkspace",
        "title": "AVC: Open Workspace in New Window",
        "icon": "$(link-external)"
      },
      {
        "command": "avc.showFileHistory",
        "title": "AVC: Show File History"
      },
      {
        "command": "avc.openFileFromSnapshot",
        "title": "AVC: Open File from Snapshot"
      },
      {
        "command": "avc.diffFileWithCurrent",
        "title": "AVC: Diff File with Current"
      },
      {
        "command": "avc.diffWithLatest",
        "title": "AVC: Diff Working Tree with Latest Snapshot"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "avc.saveSnapshot",
          "when": "view == avcSnapshots",
          "group": "navigation"
        },
        {
          "command": "avc.refreshSnapshots",
          "when": "view == avcSnapshots",
          "group": "navigation"
        },
        {
          "command": "avc.createBranch",
          "when": "view == avcSnapshots",
          "group": "navigation"
        },
        {
          "command": "avc.filterSnapshots",
          "when": "view == avcSnapshots",
          "group": "navigation"
        },
        {
          "command": "avc.mergeBranch",
          "when": "view == avcSnapshots",
          "group": "navigation"
        },
        {
          "command": "avc.compareTwoSnapshots",
          "when": "view == avcSnapshots",
          "group": "navigation"
        },
        {
          "command": "avc.showTimeline",
          "when": "view == avcSnapshots",
          "group": "navigation"
        },
        {
          "command": "avc.openWorkspace",
          "when": "view == avcSnapshots",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "avc.viewInfo",
          "when": "viewItem == snapshot"
        },
        {
          "command": "avc.viewDiff",
          "when": "viewItem == snapshot"
        },
        {
          "command": "avc.diffWithCurrent",
          "when": "viewItem == snapshot"
        },
        {
          "command": "avc.restoreSnapshot",
          "when": "viewItem == snapshot"
        },
        {
          "command": "avc.deleteSnapshot",
          "when": "viewItem == snapshot"
        }
      ],
      "explorer/context": [
        {
          "command": "avc.showFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "9_avc"
        }
      ],
      "editor/context": [
        {
          "command": "avc.showFileHistory",
          "when": "resourceScheme == file",
          "group": "9_avc"
        }
      ],
      "editor/title/context": [
        {
          "command": "avc.showFileHistory",
          "when": "resourceScheme == file",
          "group": "9_avc"
        }
      ]
    },
    "configuration": {
      "title": "AVC",
      "properties": {
        "avc.projectPath": {
          "type": "string",
          "default": "",
          "description": "Path to the AVC-initialized project. Defaults to the workspace root."
        },
        "avc.defaultAgentName": {
          "type": "string",
          "default": "",
          "description": "Default agent name to use when creating snapshots."
        },
        "avc.cliPath": {
          "type": "string",
          "default": "avc",
          "description": "Path to the avc CLI binary."
        },
        "avc.autoSnapshot.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Automatically create a snapshot after saving files."
        },
        "avc.autoSnapshot.debounceSeconds": {
          "type": "number",
          "default": 30,
          "description": "Seconds to wait after the last save before creating an auto-snapshot."
        },
        "avc.autoSnapshot.cooldownMinutes": {
          "type": "number",
          "default": 5,
          "description": "Minimum minutes between auto-snapshots."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && vsce package",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
