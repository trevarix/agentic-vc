  "keywords": [
    "version-control",
    "snapshots",
    "agents",
    "mcp",
    "git-alternative"
  ],
  "skills": [
    "./avc/internal/skills/assets/skills/",
    "./plugin/skills/"
  ],
  "commands": "./plugin/commands/",
  "mcpServers": {
    "avc": {
      "command": "avc",
      "args": ["mcp", "serve", "--tools", "standard"]
    }
  }
